# ===== Backend LLM configuration =====
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-5.4-mini
OPENAI_ADMIN_KEY=

# ===== Graph backend =====
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_neo4j_password
NEO4J_DATABASE=neo4j

# ===== Backend security / local development =====
FLASK_DEBUG=false
EXPOSE_TRACEBACKS=false
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
INTERNAL_API_KEY=replace_with_shared_backend_proxy_key

# ===== Optional capacity guard overrides =====
# CAPACITY_RETRY_AFTER_SECONDS=60
# MAX_CONCURRENT_HEAVY_JOBS=2
# MAX_CONCURRENT_PREPARES=1
# MAX_CONCURRENT_GRAPH_BUILDS=1
# MAX_CONCURRENT_REPORTS=1
# MAX_CONCURRENT_RUNNING_SIMULATIONS=1
# MAX_CONCURRENT_SIMULATION_ENVS=2

# Worker-side secrets and vars are configured separately in Cloudflare.
# Important values there include:
# - SIMULATION_API
# - INTERNAL_API_KEY
# - OPENAI_ADMIN_KEY
# - JWT_SECRET
# - RESEND_API_KEY
# - RESEND_FROM_EMAIL
# - RESEND_FROM_NAME
# - AUTH_SIGNUP_VERIFICATION_SECRET
# - AUTH_SIGNUP_VERIFICATION_TTL_HOURS
# - AUTH_BASE_URL
# - SUPPORT_EMAIL
# See also: workers/.dev.vars.example

# ===== Google Ads API tooling =====
GOOGLE_ADS_CUSTOMER_ID=8165943772
GOOGLE_ADS_LOGIN_CUSTOMER_ID=5481736491
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=v22
GOOGLE_ADS_DEFAULT_LANDING_URL=https://tiresiasview.com

# ===== Google Search Console API tooling =====
# If omitted, client_id / client_secret / refresh_token can fall back to
# the Google Ads OAuth app values above. The refresh token still needs
# Search Console scope: https://www.googleapis.com/auth/webmasters
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# ===== Naver Search Ad API tooling =====
NAVER_ADS_ACCESS_LICENSE=
NAVER_ADS_SECRET_KEY=
NAVER_ADS_CUSTOMER_ID=
NAVER_ADS_BASE_URL=https://api.searchad.naver.com
NAVER_ADS_DEFAULT_LANDING_URL=https://tiresiasview.com
